{
  "name": "SmartFin AI",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  // Secrets come from GitHub → Settings → Codespaces → Secrets (see docs/CODESPACES.md). They arrive as environment variables; nothing is written to a file.
  "secrets": {
    "NEXT_PUBLIC_SUPABASE_URL": { "description": "Supabase project URL" },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": { "description": "Supabase anon (public) key" },
    "SUPABASE_SERVICE_ROLE_KEY": { "description": "Supabase service role key (server only)" },
    "GEMINI_API_KEY": { "description": "Optional: Gemini key for the AI features" },
    "NEXT_PUBLIC_RECAPTCHA_SITE_KEY": { "description": "Optional: reCAPTCHA site key (leave empty to turn the captcha off)" },
    "RECAPTCHA_SECRET_KEY": { "description": "Optional: reCAPTCHA secret key" }
  },
  "forwardPorts": [3000],
  // Private: only you (signed in to GitHub) can open the forwarded URL.
  "portsAttributes": { "3000": { "label": "SmartFin AI", "onAutoForward": "openBrowser", "visibility": "private" } },
  "postCreateCommand": "npm ci",
  // Starts the app every time the codespace is opened. The site URL is the codespace's own forwarded address, so login emails and redirects point back to it.
  "postAttachCommand": "NEXT_PUBLIC_SITE_URL=https://${CODESPACE_NAME}-3000.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN} npm run dev -- --hostname 0.0.0.0",
  "customizations": { "vscode": { "extensions": ["dbaeumer.vscode-eslint", "bradlc.vscode-tailwindcss"] } }
}
