# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=      # notifications, account deletion
# AI (optional; either works). Gemini has a FREE tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=                 # alternative to Gemini
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
# Optional: integration test DB (see tests/integration)
TEST_DATABASE_URL=
# Account Aggregator via Setu (see docs/ACCOUNT_AGGREGATOR.md)
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
SETU_BASE_URL=https://fiu-sandbox.setu.co

# Public contact details shown on /contact
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_CONTACT_ROLE=       # e.g. "Founder, SmartFin AI"
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
# --- Bot protection on "Create account" (Google reCAPTCHA v2 checkbox) ---
# Create keys at https://www.google.com/recaptcha/admin/create (type: reCAPTCHA v2, "I'm not a robot"; add your domains, and localhost for testing).
# NEXT_PUBLIC_ is the public site key (shown in the page). The secret key stays on the server only. Leave both empty to turn the captcha off.
# For local testing Google publishes keys that always pass (they show a "testing only" banner; never use them in production):
#   NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Razorpay payments (paid plans). Test keys (rzp_test_...) charge no real money; live keys (rzp_live_...) do. See docs/PAYMENTS.md ---
# Key ID is public-safe; Key Secret and Webhook Secret are SERVER ONLY. Never put them in NEXT_PUBLIC_* or commit them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # you choose this when adding the webhook in the Razorpay dashboard
# Paid plans stay hidden ("Coming soon") until this is exactly "true". Everyone is free until then.
PAYMENTS_ENABLED=false
# Optional price overrides in whole rupees (defaults 99 / 999)
PRO_MONTHLY_PRICE_INR=
PRO_YEARLY_PRICE_INR=
